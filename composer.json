{
    "name": "kode/miniapp",
    "description": "多平台小程序、公众号、企业号、微信开放平台统一接入 SDK（微信、支付宝、抖音、百度、QQ、企业微信、钉钉、飞书）",
    "type": "library",
    "keywords": [
        "小程序",
        "公众号",
        "企业微信",
        "钉钉",
        "飞书",
        "微信开放平台",
        "微信支付",
        "支付宝",
        "抖音",
        "wechat",
        "openplatform",
        "miniprogram",
        "mp"
    ],
    "homepage": "https://github.com/kode-lab/miniapp",
    "license": "Apache-2.0",
    "version": "1.10.0",
    "authors": [
        {
            "name": "Kode Lab",
            "email": "dev@kode.lab"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/cache": "^6.4|^7.0",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "kode/pays": "企业级多平台聚合支付 SDK，支持微信、支付宝、云闪付、抖音支付等国内外主流支付渠道",
        "kode/tools": "PHP 通用工具包，包含消息体、加解密、二维码、数组/字符串/时间处理等",
        "kode/exception": "统一的异常处理组件，支持异常码体系、异常转换、异常上报",
        "kode/cache": "高性能缓存组件，支持文件、Redis、Memcached、APCu 等多种驱动",
        "kode/event": "轻量级事件编排库，支持事件派发、监听、订阅、异步事件"
    },
    "autoload": {
        "psr-4": {
            "Kode\\MiniApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\MiniApp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests --level=8",
        "cs": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests",
        "check": [
            "@phpstan",
            "@cs",
            "@test"
        ],
        "version:bump": "php scripts/bump-version.php",
        "version:tag": "php scripts/tag-release.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
