includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # 接口契约保留参数位（evictConflicts 与调用方签名对称，未来扩展用）
        -
            identifier: method.unusedParameter
        # 测试套件对计数器/策略实例的静态推断过度（经闭包引用/新实例返回变化）
        -
            identifier: staticMethod.alreadyNarrowedType
        # 测试断言中跨层签名收窄（phpdoc param 与实际传入形状差异属测试容差）
        -
            identifier: argument.type
            path: tests/Union/Bridge/*
